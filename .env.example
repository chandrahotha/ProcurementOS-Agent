# ProcurementOS-Agent — env template.
# Copy to .env for local dev and fill values as needed. Staging/prod use a
# secret manager; never commit .env. Keys below marked (unused) are not read
# by app.core/config.py Settings yet — tracked in bugs/04-infra-ci.md I37.
# See prerequisite-docs/10_SEED_DEMO_DEPLOY_ROADMAP.md for environment separation.

# --- Core (Settings: app_env, api_version) ---
APP_ENV=development
API_VERSION=v1
REQUEST_ID_HEADER=X-Request-ID  # (unused)

# --- Database (own schema pos_*, own DB per env) ---
# DATABASE_URL is the ASYNC url the app uses (asyncpg/aiosqlite).
DATABASE_URL=
# DATABASE_SYNC_URL is the SYNC url alembic uses (psycopg). The name is
# DATABASE_SYNC_URL — alembic/env.py reads exactly that, and the key was
# previously documented as DATABASE_URL_SYNC, so a copied template set the
# wrong variable and the migration silently used the committed default.
DATABASE_SYNC_URL=

# --- Object storage (S3-compatible, own prefix pos-tenant-{id}/) ---
S3_ENDPOINT=
S3_BUCKET=
# boto3 reads the AWS_*-style names below (S3_* keys were dead config).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# --- Queue (own namespace pos:*) ---
REDIS_URL=

# --- Outbox delivery (transport-gated: approved messages really send) ---
OUTBOX_WEBHOOK_URL=

# --- Auth (OIDC) ---
# Required for staging/prod: with APP_ENV=production and no issuer the app
# refuses to boot (dev-token fallback is dev/test only).
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_CLIENT_ID=  # (unused)
OIDC_CLIENT_SECRET=  # (unused)
MFA_ENFORCED=false  # (unused)

# --- AI (provider abstraction; primary + fallback; server-side only) ---
# When a base URL is configured, AI touchpoints call it through
# run_with_fallback + the hallucination scan (AIJob/AIResult persisted).
AI_PRIMARY_BASE_URL=
AI_PRIMARY_API_KEY=
AI_PRIMARY_MODEL=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_TIMEOUT_S=30
AI_CIRCUIT_BREAKER_S=60

# --- Seed (synthetic only; refuses prod-flagged DBs) ---
SEED_TENANT_CODE=SYN-TENANT-01
SEED_ADMIN_EMAIL=  # (unused)
SEED_ADMIN_PASSWORD=  # (unused)

# --- Web ---
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
WEB_ORIGIN=http://localhost:3000
