# ProcurementOS-Agent — env template (NO VALUES, keys only).
# Copy to .env for local dev. Staging/prod use a secret manager; never commit .env.
# See prerequisite-docs/10_SEED_DEMO_DEPLOY_ROADMAP.md for environment separation.

# --- Core ---
APP_ENV=development
API_VERSION=v1
REQUEST_ID_HEADER=X-Request-ID

# --- Database (own schema pos_*, own DB per env) ---
DATABASE_URL=postgresql+asyncpg://pos:pos@localhost:5432/pos
DATABASE_URL_SYNC=postgresql+psycopg://pos:pos@localhost:5432/pos

# --- Object storage (S3-compatible, own prefix pos-tenant-{id}/) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pos-artifacts
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- Queue (own namespace pos:*) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth (OIDC) ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
MFA_ENFORCED=false

# --- AI (provider abstraction; primary + fallback; server-side only) ---
AI_PRIMARY_BASE_URL=
AI_PRIMARY_API_KEY=
AI_PRIMARY_MODEL=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_TIMEOUT_S=30
AI_CIRCUIT_BREAKER_S=60

# --- Seed (synthetic only; refuses prod-flagged DBs) ---
SEED_TENANT_CODE=SYN-TENANT-01
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Web ---
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
