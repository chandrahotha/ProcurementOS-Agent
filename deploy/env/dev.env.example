# ProcurementOS-Agent — DEVELOPMENT environment template.
#
# Copy to `.env` and adjust. This is the ONLY environment whose values may
# be non-secret defaults: the database and queue are local containers and
# the OIDC issuer is a local file-based mock.
#
# Staging and production use their own templates:
#   deploy/env/staging.env.example
#   deploy/env/prod.env.example
# and `python scripts/verify_env.py` refuses a staging or production file
# that carries any of the dev values below.
#
# Verify before use:  python scripts/verify_env.py --env .env --profile dev

APP_ENV=development
API_VERSION=v1

# --- Database (async for the app, sync for alembic) ---
DATABASE_URL=postgresql+asyncpg://pos:pos@localhost:5432/pos
DATABASE_SYNC_URL=postgresql+psycopg://pos:pos@localhost:5432/pos

# --- Queue (RQ namespace pos:*) ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (S3-compatible; local MinIO in compose) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pos-artifacts
AWS_ACCESS_KEY_ID=pos
AWS_SECRET_ACCESS_KEY=posminio123
AWS_DEFAULT_REGION=us-east-1

# --- Auth (OIDC) ---
# Leave empty in dev: the app falls back to seeded dev tokens, which are
# unreachable as soon as OIDC_ISSUER is set.
OIDC_ISSUER=
OIDC_AUDIENCE=

# --- AI (server-side only; empty = deterministic notes only) ---
AI_PRIMARY_BASE_URL=
AI_PRIMARY_API_KEY=
AI_PRIMARY_MODEL=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_TIMEOUT_S=30
AI_CIRCUIT_BREAKER_S=60

# --- Outbox delivery (empty = approved messages stay queued) ---
OUTBOX_WEBHOOK_URL=

# --- Web ---
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
WEB_ORIGIN=http://localhost:3000
