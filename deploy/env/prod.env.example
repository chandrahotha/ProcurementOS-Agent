# ProcurementOS-Agent — PRODUCTION environment template.
#
# Every value below is a PLACEHOLDER, filled from the secret manager. The
# filled file is never committed and never shipped in an image.
#
#   python scripts/verify_env.py --env .env.prod --profile production
#
# `APP_ENV=production` is the switch that matters: app/core/config.py
# refuses to boot without OIDC_ISSUER and OIDC_AUDIENCE, so the dev-token
# fallback is unreachable in production by construction rather than by
# convention.

APP_ENV=production
API_VERSION=v1

# --- Database (a database of its own) ---
DATABASE_URL=postgresql+asyncpg://REPLACE_ME:REPLACE_ME@REPLACE_ME:5432/REPLACE_ME
DATABASE_SYNC_URL=postgresql+psycopg://REPLACE_ME:REPLACE_ME@REPLACE_ME:5432/REPLACE_ME

# --- Queue ---
REDIS_URL=redis://REPLACE_ME:6379/0

# --- Object storage ---
S3_ENDPOINT=https://REPLACE_ME
S3_BUCKET=pos-artifacts-production
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_DEFAULT_REGION=eu-west-1

# --- Auth (OIDC) — mandatory: the app will not boot without them ---
OIDC_ISSUER=https://REPLACE_ME/realms/REPLACE_ME
OIDC_AUDIENCE=REPLACE_ME

# --- AI (server-side only) ---
AI_PRIMARY_BASE_URL=https://REPLACE_ME
AI_PRIMARY_API_KEY=REPLACE_ME
AI_PRIMARY_MODEL=REPLACE_ME
AI_FALLBACK_BASE_URL=https://REPLACE_ME
AI_FALLBACK_API_KEY=REPLACE_ME
AI_FALLBACK_MODEL=REPLACE_ME
AI_TIMEOUT_S=30
AI_CIRCUIT_BREAKER_S=60

# --- Outbox delivery ---
OUTBOX_WEBHOOK_URL=https://REPLACE_ME/webhook

# --- Web ---
NEXT_PUBLIC_API_BASE=https://api.REPLACE_ME/api/v1
WEB_ORIGIN=https://app.REPLACE_ME
