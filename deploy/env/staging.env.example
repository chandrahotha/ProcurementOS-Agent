# ProcurementOS-Agent — STAGING environment template.
#
# Every value below is a PLACEHOLDER. Fill it from the secret manager; do
# not commit the filled file. This template is the checklist of what staging
# must define, and `python scripts/verify_env.py --profile staging` fails
# while any of them is still a placeholder or still a development value.
#
#   python scripts/verify_env.py --env .env.staging --profile staging

APP_ENV=staging
API_VERSION=v1

# --- Database (a database of its own; never the dev one) ---
DATABASE_URL=postgresql+asyncpg://REPLACE_ME:REPLACE_ME@REPLACE_ME:5432/REPLACE_ME
DATABASE_SYNC_URL=postgresql+psycopg://REPLACE_ME:REPLACE_ME@REPLACE_ME:5432/REPLACE_ME

# --- Queue (a Redis of its own; the pos: namespace may be shared) ---
REDIS_URL=redis://REPLACE_ME:6379/0

# --- Object storage (a bucket of its own) ---
S3_ENDPOINT=https://REPLACE_ME
S3_BUCKET=pos-artifacts-staging
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
AWS_DEFAULT_REGION=eu-west-1

# --- Auth (OIDC) ---
# Staging authenticates against a real issuer. There is no dev-token
# fallback outside development: the app refuses to boot in production
# without these, and staging is expected to behave the same way.
OIDC_ISSUER=https://REPLACE_ME/realms/REPLACE_ME
OIDC_AUDIENCE=REPLACE_ME

# --- AI (server-side only) ---
AI_PRIMARY_BASE_URL=https://REPLACE_ME
AI_PRIMARY_API_KEY=REPLACE_ME
AI_PRIMARY_MODEL=REPLACE_ME
AI_FALLBACK_BASE_URL=https://REPLACE_ME
AI_FALLBACK_API_KEY=REPLACE_ME
AI_FALLBACK_MODEL=REPLACE_ME
AI_TIMEOUT_S=30
AI_CIRCUIT_BREAKER_S=60

# --- Outbox delivery (approved messages really send) ---
OUTBOX_WEBHOOK_URL=https://REPLACE_ME/webhook

# --- Web ---
NEXT_PUBLIC_API_BASE=https://api.staging.REPLACE_ME/api/v1
WEB_ORIGIN=https://app.staging.REPLACE_ME
