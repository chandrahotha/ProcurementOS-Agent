FROM python:3.12-slim AS deps
WORKDIR /srv
COPY pyproject.toml ./
RUN pip install --no-cache-dir -e .

FROM python:3.12-slim AS runtime
WORKDIR /srv
COPY --from=deps /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin
COPY pyproject.toml ./
COPY app/ ./app/
COPY engine/ ./engine/
COPY worker/ ./worker/
RUN useradd --system --create-home --uid 10002 posworker && chown -R posworker:posworker /srv
USER posworker
CMD ["python", "-m", "worker.task_worker"]
